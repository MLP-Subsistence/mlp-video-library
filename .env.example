# Local Windows / Electron development uses SQLite:
DATABASE_URL="file:../dev.db"

# Netlify production should use a hosted Postgres URL from Neon or Supabase:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# Supabase/Prisma table setup should also use the direct connection URL:
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Use a long random value in production. Do not reuse this placeholder.
SESSION_SECRET="replace-with-a-long-random-secret"

# Server-side only. Rotate before public launch if this key was shared during development.
YOUTUBE_API_KEY=""

# Local HTTP: false. Netlify HTTPS: true.
COOKIE_SECURE="false"

# Netlify production:
# NETLIFY="true"
# COOKIE_SECURE="true"
# NETLIFY_NEXT_SKEW_PROTECTION="true"
# NEXT_PUBLIC_SITE_URL="https://your-temporary-site.netlify.app"
# NODE_VERSION="20"

# ---------------------------------------------------------------------------
# Educator Studio (video localization)
# ---------------------------------------------------------------------------
# Media storage: "local" (disk, dev/Electron/self-hosted) or "s3" (any S3-compatible bucket:
# Supabase Storage S3 endpoint, Cloudflare R2, AWS S3, MinIO). Netlify needs "s3".
STUDIO_STORAGE_DRIVER="local"
# STUDIO_STORAGE_DIR="./storage/studio"
# STUDIO_S3_ENDPOINT="https://<project>.supabase.co/storage/v1/s3"
# STUDIO_S3_REGION="auto"
# STUDIO_S3_BUCKET="educator-studio"
# STUDIO_S3_ACCESS_KEY_ID=""
# STUDIO_S3_SECRET_ACCESS_KEY=""
# STUDIO_S3_PUBLIC_URL="https://<project>.supabase.co/storage/v1/object/public/educator-studio"

# Translation + full-narration alignment (server/worker only).
OPENAI_API_KEY=""
# ElevenLabs AI Voice (server/worker only). Select the provider under /admin/studio → Providers.
ELEVENLABS_API_KEY=""

# Development only: run render/alignment jobs inside the Next process (needs FFmpeg on PATH).
# In production run `npm run worker` on a machine with FFmpeg instead.
STUDIO_INLINE_WORKER="false"
# FFMPEG_PATH="C:\ffmpeg\bin\ffmpeg.exe"
# FFPROBE_PATH="C:\ffmpeg\bin\ffprobe.exe"
# STUDIO_WORK_DIR=""   # scratch directory for the worker (defaults to the OS temp dir)
